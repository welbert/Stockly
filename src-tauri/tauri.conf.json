{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bora Vender",
  "version": "0.0.2",
  "identifier": "com.welbert.stockly",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bora Vender",
        "width": 1550,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "visible": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCQkJENzc1REExNThGMzAKUldRd2p4WGFkZGU3VzVNSlZ6Wm81MDFBV2M2a1U0T0JqNGNhemxiK1JMSGZRcmhvS2lldUphdWYK",
      "endpoints": [
        "https://github.com/welbert/Stockly/releases/latest/download/latest.json"
      ]
    }
  }
}
